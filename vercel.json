{
  "framework": null,
  "outputDirectory": "public",
  "functions": {
    "api/aulas.js": { "includeFiles": "content/aulas-completas.html" },
    "api/arena.js": { "includeFiles": "content/arena-enem.html" },
    "api/ebook.js": { "includeFiles": "content/Descomplica_Enem_Guia_Definitivo.pdf" }
  },
  "rewrites": [
    { "source": "/webhook/cakto", "destination": "/api/webhook" },
    { "source": "/aulas-completas.html", "destination": "/api/aulas" },
    { "source": "/arena-enem.html", "destination": "/api/arena" },
    { "source": "/Descomplica_Enem_Guia_Definitivo.pdf", "destination": "/api/ebook" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Frame-Options", "value": "SAMEORIGIN" },
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Strict-Transport-Security", "value": "max-age=31536000; includeSubDomains" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=(), payment=()" }
      ]
    }
  ]
}
